# Azure Table Storage connection string.
# For local development with Azurite, this shortcut works out of the box (host 127.0.0.1, default ports):
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
#
# For a real Azure Storage account, paste the full connection string from the Azure portal, e.g.:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# MCP server bind host/port (SSE transport)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Trip planning
# Path to the JSON file used to persist trips (created on first write).
TRIPS_FILE=trips.json
# Optional webhook: if set, the full trip JSON is POSTed here on create and on every add.
# Leave empty to disable.
TRIP_WEBHOOK_URL=https://voice-agent.redisland-77d7cd39.eastus2.azurecontainerapps.io/api/trip
# Webhook HTTP timeout in seconds.
TRIP_WEBHOOK_TIMEOUT=5
